<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BigWalkMaker</AssemblyName>
    <RootNamespace>BigWalkMaker</RootNamespace>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <BigWalkManagedDir Condition="'$(BIGWALK_MANAGED_DIR)' != ''">$(BIGWALK_MANAGED_DIR)</BigWalkManagedDir>
    <BepInExRoot Condition="'$(BEPINEX_ROOT)' != ''">$(BEPINEX_ROOT)</BepInExRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExRoot)/core/BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExRoot)/interop/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BigWalkManagedDir)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(BigWalkManagedDir)/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(BigWalkManagedDir)/UnityEngine.PhysicsModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
